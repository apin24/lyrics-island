<Project>
  <!-- Shared settings for every project under windows/. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Version>0.2.0</Version>
    <Authors>Ilham Arifin</Authors>
    <Product>Lyrics Island</Product>
  </PropertyGroup>

  <!--
    Release zips: a self-contained single-file publish (the command is in windows/README.md).
    Symbols go inside the assemblies, so the zip holds only the exe and WPF's five native DLLs.
    Not used, measured on x64: EnableCompressionInSingleFile (exe 171 -> 71 MB, but about 1 s slower to
    start and 75 MB more private memory, for an app that runs all day) and IncludeNativeLibrariesForSelfExtract
    (extracts the native DLLs to %TEMP%\.net, which deleting the app's folder would leave behind).
  -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
